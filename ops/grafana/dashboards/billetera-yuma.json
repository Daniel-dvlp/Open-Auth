{
  "uid": "billetera-yuma-ops",
  "title": "Billetera Yuma - Operación",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "tags": [
    "billetera",
    "escudo",
    "ollama"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Operaciones de la billetera por estado (por minuto)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{tipo_operacion}} → {{estado}}",
          "expr": "sum by (tipo_operacion, estado) (rate(billetera_operaciones_total[5m])) * 60"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Consulta al Escudo: latencia p50 / p99 (ms) — meta < 300 ms",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "p50",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(billetera_escudo_latencia_ms_bucket[5m])))"
        },
        {
          "refId": "B",
          "legendFormat": "p99",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(billetera_escudo_latencia_ms_bucket[5m])))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Escudo sin respuesta (falla cerrada: la operación queda en revisión)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{operacion}}",
          "expr": "sum by (operacion) (increase(billetera_escudo_fallas_total[5m]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Ingresos a la app por resultado",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{resultado}}",
          "expr": "sum by (resultado) (increase(billetera_ingresos_total[5m]))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Narrativas con Ollama: latencia p50 / p95 (s)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "p50",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(yuma_narrativa_latencia_segundos_bucket[15m])))"
        },
        {
          "refId": "B",
          "legendFormat": "p95",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(yuma_narrativa_latencia_segundos_bucket[15m])))"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Narrativas por plantilla (respaldo) por motivo",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{motivo}}",
          "expr": "sum by (motivo) (increase(yuma_narrativa_fallback_total[15m]))"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Alteraciones detectadas en la cadena de auditoría",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "alteraciones",
          "expr": "sum(yuma_auditoria_alteraciones_total)"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Latencia p99 por endpoint de la billetera (s)",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{metodo}} {{endpoint}}",
          "expr": "histogram_quantile(0.99, sum by (le, endpoint, metodo) (rate(yuma_http_latencia_segundos_bucket{job=\"yuma-billetera-api\"}[5m])))"
        }
      ]
    }
  ]
}