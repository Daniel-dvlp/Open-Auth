# syntax=docker/dockerfile:1
# Billetera Yuma (YumaBilletera.Api). Misma base y endurecimiento que la imagen del Escudo (Dockerfile).
FROM mcr.microsoft.com/dotnet/sdk:8.0.428 AS build
WORKDIR /src
COPY global.json Directory.Build.props ./
COPY src/Yuma.Comun/Yuma.Comun.csproj src/Yuma.Comun/
COPY src/YumaBilletera.Api/YumaBilletera.Api.csproj src/YumaBilletera.Api/
RUN dotnet restore src/YumaBilletera.Api/YumaBilletera.Api.csproj
COPY src/Yuma.Comun/ src/Yuma.Comun/
COPY src/YumaBilletera.Api/ src/YumaBilletera.Api/
RUN dotnet publish src/YumaBilletera.Api/YumaBilletera.Api.csproj -c Release -o /app --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:8.0.34 AS final
WORKDIR /app
COPY --from=build /app .
ENV ASPNETCORE_URLS=http://+:8080 \
    DOTNET_EnableDiagnostics=0
USER $APP_UID
EXPOSE 8080
ENTRYPOINT ["dotnet", "YumaBilletera.Api.dll"]
