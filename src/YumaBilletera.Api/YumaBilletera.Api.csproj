<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Billetera Yuma: núcleo transaccional (cuentas, libro mayor de doble partida, transferencias). Cada operación que mueve dinero
       se califica ANTES en el Escudo Yuma (EscudoYuma.Api). Misma arquitectura: vertical slice + Yuma.Comun. -->
  <PropertyGroup>
    <RootNamespace>YumaBilletera.Api</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UserSecretsId>yuma-billetera-api-dev</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.*" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.*" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="8.0.*" />
    <PackageReference Include="FluentValidation" Version="11.*" />
    <PackageReference Include="prometheus-net.AspNetCore" Version="8.*" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Yuma.Comun\Yuma.Comun.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Yuma.Comun.Features" />
    <Using Include="Yuma.Comun.Web" />
    <Using Include="Yuma.Comun.Observabilidad" />
    <Using Include="Yuma.Comun.Auditoria" />
    <Using Include="Yuma.Comun.Seguridad" />
    <Using Include="Yuma.Comun.Datos" />
    <Using Include="Yuma.Comun.Tiempo" />
    <Using Include="FluentValidation" />
    <Using Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="YumaBilletera.Api.Tests" />
  </ItemGroup>
</Project>
