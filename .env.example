# Copiar a .env (ignorado por git) y completar. Nunca versionar secretos reales.
JWT_CLAVE=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
REDIS_PASSWORD=
POSTGRES_PASSWORD=cambiar
GRAFANA_PASSWORD=cambiar
# Billetera Yuma
JWT_CLAVE_BILLETERA=cambiar-por-otro-secreto-aleatorio-de-al-menos-32-caracteres
# Clave de la cuenta servicio01 del Escudo con la que se autentica la billetera (>= 16 caracteres)
ESCUDO_CLAVE_SERVICIO=cambiar-por-una-clave-de-servicio-larga
# Secreto HMAC compartido para los avisos de resolución Escudo -> billetera (>= 32 caracteres)
WEBHOOK_SECRETO=cambiar-por-un-secreto-hmac-aleatorio-de-32-o-mas
# Modelo de Ollama para las narrativas (alternativa liviana: llama3.2:3b)
OLLAMA_MODELO=qwen2.5:7b-instruct
# TLS de desarrollo (opcional): dotnet dev-certs https -ep ops/tls/escudo-dev.pfx -p <clave>  y luego descomentar
# TLS_PFX_PASSWORD=<la misma clave>
# COMPOSE_PATH_SEPARATOR=:
# COMPOSE_FILE=docker-compose.yml:docker-compose.tls.yml
